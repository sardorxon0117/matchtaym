// MatchTaym — Prisma schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
  READER
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum TransferStatus {
  RUMOR
  CONFIRMED
  OFFICIAL
}

enum FeedbackType {
  SUGGESTION
  COMPLAINT
}

enum AdContractStatus {
  PENDING_SIGNATURE // link yaratildi, hali Google orqali tasdiqlanmagan/imzolanmagan
  AWAITING_PAYMENT // imzolandi, to'lov kutilmoqda
  PAYMENT_SUBMITTED // chek yuklandi, admin tasdiqlashini kutmoqda
  CONFIRMED // to'lov tasdiqlandi, reklama joyi band qilindi
  REJECTED // yuklangan chek rad etildi, qayta yuklash kerak
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String
  image         String?
  passwordHash  String?
  role          Role      @default(READER)
  createdAt     DateTime  @default(now())

  articles Article[]
  accounts Account[]
  sessions Session[]
  comments Comment[]

  @@map("users")
}

// --- NextAuth (Auth.js) Prisma adapter schema ---
// Required for Google OAuth account linking. Credentials auth keeps using JWT
// sessions (see src/auth.ts), so the Session table is only populated for
// OAuth sign-ins, but the adapter needs it to exist regardless.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  articles Article[]

  @@map("categories")
}

model Tag {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  articles Article[] @relation("ArticleToTag")

  @@map("tags")
}

model Article {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String?
  content     String
  coverImage  String?
  status      ArticleStatus @default(DRAFT)
  views       Int           @default(0)
  readTimeMin Int           @default(3)
  metaTitle   String?
  metaDesc    String?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  tags      Tag[]      @relation("ArticleToTag")
  transfers Transfer[]
  comments  Comment[]

  @@index([status, publishedAt])
  @@map("articles")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  replies  Comment[] @relation("CommentReplies")

  @@index([articleId, createdAt])
  @@map("comments")
}

model Transfer {
  id          String         @id @default(cuid())
  playerName  String
  playerImage String?
  fromClub    String
  toClub      String
  fee         String?
  status      TransferStatus @default(RUMOR)
  date        DateTime       @default(now())
  league      String?
  createdAt   DateTime       @default(now())

  relatedArticle   Article? @relation(fields: [relatedArticleId], references: [id])
  relatedArticleId String?

  @@index([status, date])
  @@map("transfers")
}

// Site-wide ad banners, managed from the admin panel. Each banner has its
// own visibility window (startAt..endAt, to the minute); whichever banners
// are currently within their window are shown, rotating every 5 minutes if
// more than one overlaps. Mobile and desktop use separate images since their
// slots have very different aspect ratios (a thin strip vs. a tall panel).
model Banner {
  id              String   @id @default(cuid())
  mobileImageUrl  String
  desktopImageUrl String
  linkUrl         String
  startAt         DateTime
  endAt           DateTime
  // Manual on/off switch, independent of the time window.
  isEnabled       Boolean  @default(true)
  // Shown instead, whenever no regular (isFallback: false) banner is
  // currently active/enabled — a "nothing else to show" default.
  isFallback      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([startAt, endAt])
  @@map("banner")
}

// Someone on the /donate page who wants to be notified once real payment
// (Click) support goes live — a lead, not an actual payment (there is no
// payment processor wired up yet).
model DonationInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("donation_inquiries")
}

// "Taklif va shikoyatlar" — suggestions/complaints submitted from the
// /donate page's feedback form.
model Feedback {
  id        String       @id @default(cuid())
  type      FeedbackType @default(SUGGESTION)
  name      String
  email     String
  message   String
  createdAt DateTime     @default(now())

  @@index([createdAt])
  @@map("feedback")
}

// A per-advertiser ad-placement contract: admin creates it with just an
// hourly rate, sends the generated link to the advertiser, who verifies
// their email via Google, fills in their legal name + desired slot, and
// signs. The signed fields (name/dates/price/agreedAt/agreedIp) are never
// edited by any code path after signing — that's what makes the contract
// "frozen" for evidentiary purposes, without needing a separate text
// snapshot column.
model AdContract {
  id            String @id @default(cuid())
  token         String @unique @default(cuid())
  hourlyRateUzs Int

  signerEmail    String?
  signerName     String?
  startAt        DateTime?
  endAt          DateTime?
  totalAmountUzs Int?

  status AdContractStatus @default(PENDING_SIGNATURE)

  agreedAt DateTime?
  agreedIp String?

  receiptUrl         String?
  paymentSubmittedAt DateTime?
  paymentConfirmedAt DateTime?
  rejectedAt         DateTime?
  rejectReason       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startAt, endAt])
  @@map("ad_contracts")
}

// Singleton row — the admin's own payment card, shown on signed contracts
// so the advertiser knows where to transfer money. Editable from the admin
// panel without a deploy.
model AdContractSettings {
  id             String   @id @default("singleton")
  cardNumber     String?
  cardHolderName String?
  updatedAt      DateTime @updatedAt

  @@map("ad_contract_settings")
}
