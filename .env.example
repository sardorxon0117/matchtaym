# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&channel_binding=require"

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth (leave empty to disable Google sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Seed-only admin account (used by prisma/seed.ts, not read at runtime)
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""

# AWS S3 (image storage)
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# Public site URL (used for metadata / sitemap)
NEXT_PUBLIC_SITE_URL="https://matchtaym.sardorkhon.me"

# Telegram bot — new comments are sent here (leave empty to disable)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# football-data.org — top-5 league fixtures for the "O'yinlar" section
# Get a free token at https://www.football-data.org/client/register
FOOTBALL_API_KEY=""
